# Configuración del servidor
PORT=8080
ENVIRONMENT=development

# Base de datos (cuando se implemente)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# JWT Secret (cuando se implemente autenticación)
JWT_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-with-at-least-32-characters

# Logging
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=dvraDB
DB_SSLMODE=disable

# Storage local y datos demo
STORAGE_ROOT=./uploads
SEED_DEMO_DATA=false
